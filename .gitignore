__pycache__/
*.pyc
.env
.env.*
!.env.example
*.egg-info/
node_modules/
.fastembed_cache/
*.log
.coverage
.coverage.*
htmlcov/
.DS_Store

# Machine-specific (paths differ per install)
.mcp.json
.claude.json

# Runtime state (session data, not source) — handoffs are kept: they carry session state across machines
continuum/*
!continuum/research/
# research outputs stay local; only the dataviz example (read by tools/viz tests) is shared
continuum/research/*
!continuum/research/dataviz-suite/
# session handoffs stay local (they describe this machine's sessions)
thoughts/
backups/
cache/
file-history/
projects/
sessions/
session-env/
shell-snapshots/
plugins/
history.jsonl

# Build artifacts
target/

# Internal specs (not for release)
specs/

# Old Python hooks (replaced by .mjs)
.claude/hooks/*.py

# tldr auto-generates this with generic defaults
.tldrignore

# Claude Code isolated agent worktrees (full repo copies)
.claude/worktrees/
